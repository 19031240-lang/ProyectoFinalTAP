<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" styleClass="fondo-principal" stylesheets="@../css/dashboard.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.bibliotecafxv.controller.LibroController">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <Label styleClass="section-title" text="Gestión de Libros" />

    <HBox spacing="20" VBox.vgrow="ALWAYS">

        <!-- Panel izquierdo: formulario -->
        <VBox prefWidth="300" spacing="15" styleClass="card">
            <Label styleClass="section-title" text="Datos del Libro" />

            <VBox spacing="5">
                <Label text="Título:" />
                <TextField fx:id="txtTitulo" promptText="Ej. Cien años de soledad" styleClass="search-field" />
            </VBox>

            <VBox spacing="5">
                <Label text="Autor:" />
                <TextField fx:id="txtAutor" promptText="Ej. Gabriel García Márquez" styleClass="search-field" />
            </VBox>

            <VBox spacing="5">
                <Label text="Categoría:" />
                <TextField fx:id="txtCategoria" promptText="Ej. Novela" styleClass="search-field" />
            </VBox>

            <VBox spacing="5">
                <Label text="Descripción:" />
                <TextArea fx:id="txtDescripcion" promptText="Breve descripción del libro..."
                          prefHeight="90" styleClass="search-field" wrapText="true"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Ruta de portada:" />
                <TextField fx:id="txtPortada" promptText="Ej. /img/portada.jpg" styleClass="search-field" />
            </VBox>

            <CheckBox fx:id="chkDisponible" text="Disponible" selected="true" />

            <!-- Botones -->
            <HBox spacing="8" alignment="CENTER">
                <Button text="Guardar"
                        styleClass="menu-button-active"
                        onAction="#guardarLibro"
                        prefWidth="85"/>
                <Button text="Actualizar"
                        styleClass="menu-button-active"
                        onAction="#actualizarLibro"
                        prefWidth="85"/>
                <Button text="Limpiar"
                        styleClass="menu-button"
                        onAction="#limpiarFormulario"
                        prefWidth="85"/>
            </HBox>
        </VBox>

        <!-- Panel derecho: tabla -->
        <VBox spacing="10" styleClass="card" HBox.hgrow="ALWAYS">

            <!-- Barra de búsqueda -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label styleClass="section-title" text="Lista de Libros" HBox.hgrow="ALWAYS"/>
                <TextField fx:id="txtBuscar" promptText="Buscar libro..." styleClass="search-field" prefWidth="200"/>
                <Button text="Buscar" styleClass="menu-button" onAction="#buscarLibro"/>
            </HBox>

            <TableView fx:id="tblLibros" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId"          prefWidth="50"  text="ID"          />
                    <TableColumn fx:id="colTitulo"       prefWidth="180" text="Título"       />
                    <TableColumn fx:id="colAutor"        prefWidth="140" text="Autor"        />
                    <TableColumn fx:id="colCategoria"    prefWidth="110" text="Categoría"    />
                    <TableColumn fx:id="colDisponible"   prefWidth="90"  text="Disponible"   />
                    <TableColumn fx:id="colDescripcion"  prefWidth="220" text="Descripción"  />
                </columns>
            </TableView>

            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Button text="Eliminar Seleccionado"
                        styleClass="menu-button"
                        style="-fx-text-fill: red;"
                        onAction="#eliminarLibro"/>
            </HBox>
        </VBox>

    </HBox>
</VBox>