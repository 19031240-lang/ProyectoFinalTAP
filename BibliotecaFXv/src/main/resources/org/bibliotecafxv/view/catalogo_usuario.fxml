<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.bibliotecafxv.controller.CatalogoUsuarioController"
            stylesheets="@../css/dashboard.css"
            styleClass="fondo-principal">

    <top>
        <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="20">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>
            <Label text="📚 Catálogo de la Biblioteca"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="🚪 Cerrar Sesión"
                    styleClass="menu-button"
                    style="-fx-text-fill: #e74c3c;"
                    onAction="#cerrarSesion"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-padding: 20;">
            <FlowPane fx:id="contenedorLibros" hgap="20" vgap="20" alignment="TOP_LEFT" />
        </ScrollPane>
    </center>

    <right>
        <VBox fx:id="panelDetalles" styleClass="right-panel" prefWidth="320" spacing="15" alignment="TOP_CENTER" visible="false">
            <padding>
                <Insets top="30" right="20" bottom="30" left="20"/>
            </padding>

            <Label text="Detalles del Libro" styleClass="section-title"/>

            <ImageView fx:id="imgPortadaDetalle" fitWidth="180" fitHeight="260" preserveRatio="false"/>

            <Label fx:id="lblTituloDetalle" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" wrapText="true" textAlignment="CENTER"/>
            <Label fx:id="lblAutorDetalle" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>

            <Label fx:id="lblCategoriaDetalle" style="-fx-font-size: 13px; -fx-font-style: italic; -fx-text-fill: #34495e;"/>

            <VBox spacing="5" alignment="TOP_LEFT" prefWidth="280">
                <Label text="Descripción:" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 13px;"/>
                <Label fx:id="lblDescripcionDetalle" style="-fx-font-size: 13px; -fx-text-fill: #555555;" wrapText="true" prefWidth="280"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <Label fx:id="lblEstadoSms" style="-fx-font-weight: bold;"/>
            <Button fx:id="btnSolicitar" text="Solicitar Préstamo" styleClass="menu-button-active" prefWidth="250" prefHeight="40" onAction="#solicitarPrestamo"/>

        </VBox>
    </right>

</BorderPane>