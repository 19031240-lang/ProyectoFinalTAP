<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" styleClass="fondo-principal" stylesheets="@../css/dashboard.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.bibliotecafxv.controller.ReportesController">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <Label styleClass="section-title" text="Reportes y Exportación" />

    <HBox spacing="20" VBox.vgrow="ALWAYS">

        <VBox prefWidth="400" spacing="15" styleClass="card">
            <Label styleClass="section-title" text="Generar Reportes PDF" />

            <Label text="Documentos listos para imprimir o enviar por correo." textFill="#888888" wrapText="true"/>

            <VBox spacing="15" alignment="CENTER">
                <Button onAction="#generarPdfMorosos" prefWidth="350" prefHeight="40"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;"
                        text="📄 Reporte de Usuarios Morosos" />

                <Button onAction="#generarPdfPrestamos" prefWidth="350" prefHeight="40"
                        styleClass="menu-button-active" style="-fx-background-radius: 10;"
                        text="📄 Reporte de Libros Prestados" />
            </VBox>
        </VBox>

        <VBox spacing="15" styleClass="card" HBox.hgrow="ALWAYS">
            <Label styleClass="section-title" text="Respaldo del Catálogo" />

            <Label text="Exporta la lista completa de libros a un archivo externo para tener un respaldo de la información." textFill="#888888" wrapText="true"/>

            <VBox spacing="15" alignment="CENTER_LEFT">
                <Button onAction="#exportarCatalogoJson" prefWidth="300" prefHeight="40"
                        style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;"
                        text="📁 Exportar Catálogo (JSON)" />

                <Button onAction="#exportarCatalogoCsv" prefWidth="300" prefHeight="40"
                        style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;"
                        text="📊 Exportar Catálogo (CSV)" />
            </VBox>
        </VBox>

    </HBox>
</VBox>