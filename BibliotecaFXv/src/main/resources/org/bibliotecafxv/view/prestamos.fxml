<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" styleClass="fondo-principal" stylesheets="@../css/dashboard.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.bibliotecafxv.controller.PrestamosController">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <Label styleClass="section-title" text="Gestión de Préstamos" />

    <HBox spacing="20" VBox.vgrow="ALWAYS">

        <VBox prefWidth="300" spacing="15" styleClass="card">
            <Label styleClass="section-title" text="Datos del Préstamo" />

            <VBox spacing="5">
                <Label text="Seleccionar Usuario:" />
                <ComboBox fx:id="cmbUsuario" prefWidth="280" promptText="Seleccione un usuario..." styleClass="search-field" />
            </VBox>

            <VBox spacing="5">
                <Label text="Seleccionar Libro:" />
                <ComboBox fx:id="cmbLibro" prefWidth="280" promptText="Seleccione un libro..." styleClass="search-field" />
            </VBox>

            <VBox spacing="5">
                <Label text="Fecha de Devolución:" />
                <DatePicker fx:id="dpFechaDevolucion" prefWidth="280" styleClass="search-field" />
            </VBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="Guardar" styleClass="menu-button-active" onAction="#registrarPrestamo" prefWidth="85"/>
                <Button text="Actualizar" styleClass="menu-button-active" onAction="#actualizarPrestamo" prefWidth="85"/>
                <Button text="Limpiar" styleClass="menu-button" onAction="#limpiarFormulario" prefWidth="85"/>
            </HBox>

            <Separator prefWidth="280" />

            <Button text="Marcar como Devuelto"
                    style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;"
                    onAction="#finalizarPrestamo" prefWidth="280" prefHeight="35"/>
        </VBox>

        <VBox spacing="10" styleClass="card" HBox.hgrow="ALWAYS">
            <Label styleClass="section-title" text="Lista de Préstamos" />

            <TextField fx:id="txtBuscar" promptText="Buscar por nombre de usuario o libro..." styleClass="search-field" />

            <TableView fx:id="tablaPrestamos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="40" text="ID" />
                    <TableColumn fx:id="colUsuario" prefWidth="150" text="Usuario" />
                    <TableColumn fx:id="colLibro" prefWidth="180" text="Libro" />
                    <TableColumn fx:id="colFechaPrestamo" prefWidth="100" text="F. Préstamo" />
                    <TableColumn fx:id="colFechaDevolucion" prefWidth="100" text="F. Límite" />
                    <TableColumn fx:id="colEstado" prefWidth="90" text="Estado" />
                </columns>
            </TableView>

            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Button text="Eliminar Seleccionado" styleClass="menu-button" style="-fx-text-fill: red; -fx-font-weight: bold;" onAction="#eliminarPrestamo"/>
            </HBox>
        </VBox>

    </HBox>
</VBox>