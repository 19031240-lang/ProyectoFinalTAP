<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" styleClass="fondo-principal" stylesheets="@../css/dashboard.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.bibliotecafxv.controller.PrestamosController">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <Label styleClass="section-title" text="Gestión de Préstamos" />

    <HBox spacing="20" VBox.vgrow="ALWAYS">

        <VBox prefWidth="350" spacing="15" styleClass="card">
            <Label styleClass="section-title" text="Nuevo Préstamo" />

            <VBox spacing="5">
                <Label text="Seleccionar Usuario:" />
                <ComboBox fx:id="cmbUsuario" prefWidth="310" promptText="Seleccione un usuario..." styleClass="search-field" />
            </VBox>

            <VBox spacing="5">
                <Label text="Seleccionar Libro:" />
                <ComboBox fx:id="cmbLibro" prefWidth="310" promptText="Seleccione un libro..." styleClass="search-field" />
            </VBox>

            <VBox spacing="5">
                <Label text="Fecha de Devolución:" />
                <DatePicker fx:id="dpFechaDevolucion" prefWidth="310" styleClass="search-field" />
            </VBox>

            <VBox spacing="10" alignment="CENTER">
                <Button onAction="#registrarPrestamo" prefWidth="310" styleClass="menu-button-active" text="Realizar Préstamo" />
                <Button onAction="#limpiarFormulario" prefWidth="310" styleClass="menu-button" text="Limpiar Campos" />
            </VBox>
        </VBox>

        <VBox spacing="10" styleClass="card" HBox.hgrow="ALWAYS">
            <Label styleClass="section-title" text="Historial de Movimientos" />

            <TableView fx:id="tablaPrestamos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="40" text="ID" />
                    <TableColumn fx:id="colUsuario" prefWidth="150" text="Usuario" />
                    <TableColumn fx:id="colLibro" prefWidth="180" text="Libro" />
                    <TableColumn fx:id="colFechaPrestamo" prefWidth="120" text="F. Préstamo" />
                    <TableColumn fx:id="colFechaDevolucion" prefWidth="120" text="F. Devolución" />
                    <TableColumn fx:id="colEstado" prefWidth="100" text="Estado" />
                </columns>
            </TableView>

            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Button onAction="#finalizarPrestamo" styleClass="menu-button-active" style="-fx-background-color: #2ecc71;" text="Marcar como Devuelto" />
            </HBox>
        </VBox>

    </HBox>
</VBox>