<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>

<BorderPane fx:id="rootPane"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.bibliotecafxv.controller.DashboardController"
            stylesheets="@../css/dashboard.css"
            styleClass="fondo-principal">
    <left>
        <VBox styleClass="sidebar">
            <Label text="📚 Biblioteca Digital" styleClass="logo-title"/>
            <Button text="🏠 Dashboard"  styleClass="menu-button, menu-button-active" onAction="#abrirDashboard"/>
            <Button text="📘 Libros"     styleClass="menu-button" onAction="#abrirLibros"/>
            <Button text="👤 Usuarios"   styleClass="menu-button" onAction="#abrirUsuarios"/>
            <Button text="🔄 Préstamos"  styleClass="menu-button" onAction="#abrirPrestamos"/>
            <Button text="📊 Reportes"   styleClass="menu-button" onAction="#abrirReportes"/>

            <Region VBox.vgrow="ALWAYS" />

            <Button text="🚪 Cerrar Sesión" styleClass="menu-button" style="-fx-text-fill: #e74c3c;" onAction="#cerrarSesion"/>
        </VBox>
    </left>

    <center>
        <VBox fx:id="contentPane" spacing="20">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- Topbar SIN buscador, solo notificación y usuario -->
            <HBox styleClass="topbar" alignment="CENTER_RIGHT" spacing="10">
                <Label text="🔔" styleClass="icon-bell"/>
                <Label text="Administrador" styleClass="admin-label"/>
            </HBox>

            <!-- Tarjetas de estadísticas -->
            <HBox spacing="20">
                <VBox styleClass="card" prefWidth="220">
                    <Label text="Total libros"  styleClass="card-title"/>
                    <Label fx:id="lblTotalLibros"   text="0" styleClass="card-number"/>
                </VBox>
                <VBox styleClass="card" prefWidth="220">
                    <Label text="Usuarios"      styleClass="card-title"/>
                    <Label fx:id="lblTotalUsuarios"  text="0" styleClass="card-number"/>
                </VBox>
                <VBox styleClass="card" prefWidth="220">
                    <Label text="Préstamos"     styleClass="card-title"/>
                    <Label fx:id="lblTotalPrestamos" text="0" styleClass="card-number"/>
                </VBox>
            </HBox>

            <Label text="Libros Destacados" styleClass="section-title">
                <VBox.margin>
                    <Insets top="20" bottom="10"/>
                </VBox.margin>
            </Label>

            <HBox fx:id="contenedorLibros" spacing="20" />

            <VBox styleClass="card" VBox.vgrow="ALWAYS" spacing="10">
                <Label text="Préstamos Recientes" styleClass="section-title"/>
                <TableView fx:id="tablaPrestamos" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colUsuario" text="Usuario"           prefWidth="200"/>
                        <TableColumn fx:id="colLibro"   text="Libro"             prefWidth="250"/>
                        <TableColumn fx:id="colFecha"   text="Fecha Devolución"  prefWidth="150"/>
                    </columns>
                </TableView>
            </VBox>

        </VBox>
    </center>

    <right>
        <VBox fx:id="panelDerecho" styleClass="right-panel" spacing="20" prefWidth="300">
            <padding>
                <Insets top="20" right="20" bottom="20" left="0"/>
            </padding>

            <VBox styleClass="calendar-card" alignment="TOP_CENTER">
                <Label text="Calendario" styleClass="section-title"/>
                <VBox fx:id="contenedorCalendario" spacing="15" alignment="CENTER"/>
            </VBox>

            <VBox styleClass="card" spacing="10" VBox.vgrow="ALWAYS">
                <Label text="Actividad Semanal" styleClass="section-title"/>
                <BarChart fx:id="graficaPrestamos" legendVisible="false" VBox.vgrow="ALWAYS">
                    <xAxis><CategoryAxis side="BOTTOM"/></xAxis>
                    <yAxis><NumberAxis side="LEFT"/></yAxis>
                </BarChart>
            </VBox>
        </VBox>
    </right>

</BorderPane>