<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<VBox spacing="20" styleClass="fondo-principal" stylesheets="@../css/dashboard.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.bibliotecafxv.controller.UsuarioController">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <Label styleClass="section-title" text="Gestión de Usuarios" />

    <HBox spacing="20" VBox.vgrow="ALWAYS">

        <!-- Panel izquierdo: formulario -->
        <VBox prefWidth="300" spacing="15" styleClass="card">
            <Label styleClass="section-title" text="Datos del Usuario" />

            <VBox spacing="5">
                <Label text="Nombre Completo:" />
                <TextField fx:id="txtNombre" promptText="Ej. Juan Pérez" styleClass="search-field" />
            </VBox>

            <VBox spacing="5">
                <Label text="Correo Electrónico:" />
                <TextField fx:id="txtCorreo" promptText="ejemplo@correo.com" styleClass="search-field" />
            </VBox>

            <VBox spacing="5">
                <Label text="Contraseña:" />
                <PasswordField fx:id="txtPassword"
                               promptText="Nueva contraseña"
                               styleClass="search-field" />
            </VBox>

            <VBox spacing="5">
                <Label text="Rol en el sistema:" />
                <ComboBox fx:id="cmbRol" prefWidth="260" styleClass="search-field">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="ADMIN"/>
                            <String fx:value="USER"/>
                        </FXCollections>
                    </items>
                </ComboBox>
            </VBox>

            <!-- Botones: Guardar | Actualizar | Limpiar -->
            <HBox spacing="8" alignment="CENTER">
                <Button text="Guardar"
                        styleClass="menu-button-active"
                        onAction="#guardarUsuario"
                        prefWidth="85"/>
                <Button text="Actualizar"
                        styleClass="menu-button-active"
                        onAction="#actualizarUsuario"
                        prefWidth="85"/>
                <Button text="Limpiar"
                        styleClass="menu-button"
                        onAction="#limpiarFormulario"
                        prefWidth="85"/>
            </HBox>
        </VBox>

        <!-- Panel derecho: tabla -->
        <VBox spacing="10" styleClass="card" HBox.hgrow="ALWAYS">
            <Label styleClass="section-title" text="Lista de Usuarios" />

            <TableView fx:id="tablaUsuarios" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId"     prefWidth="50"  text="ID"     />
                    <TableColumn fx:id="colNombre"  prefWidth="200" text="Nombre" />
                    <TableColumn fx:id="colCorreo"  prefWidth="200" text="Correo" />
                    <TableColumn fx:id="colRol"     prefWidth="100" text="Rol"    />
                </columns>
            </TableView>

            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Button text="Eliminar Seleccionado"
                        styleClass="menu-button"
                        style="-fx-text-fill: red;"
                        onAction="#eliminarUsuario"/>
            </HBox>
        </VBox>

    </HBox>
</VBox>