<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" styleClass="fondo-principal" stylesheets="@../css/dashboard.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.bibliotecafxv.controller.AutorController">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <Label styleClass="section-title" text="Gestión de Autores" />

    <HBox spacing="20" VBox.vgrow="ALWAYS">

        <VBox prefWidth="300" spacing="15" styleClass="card">
            <Label styleClass="section-title" text="Datos del Autor" />

            <VBox spacing="5">
                <Label text="Nombre del Autor:" />
                <TextField fx:id="txtNombre" prefWidth="280" promptText="Escribe el nombre..." styleClass="search-field" />
            </VBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="Guardar" styleClass="menu-button-active" onAction="#guardarAutor" prefWidth="85"/>
                <Button text="Actualizar" styleClass="menu-button-active" onAction="#actualizarAutor" prefWidth="85"/>
                <Button text="Limpiar" styleClass="menu-button" onAction="#limpiarFormulario" prefWidth="85"/>
            </HBox>
        </VBox>

        <VBox spacing="10" styleClass="card" HBox.hgrow="ALWAYS">
            <Label styleClass="section-title" text="Lista de Autores" />

            <TableView fx:id="tblAutores" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="60" text="ID" />
                    <TableColumn fx:id="colNombre" prefWidth="350" text="Nombre del Autor" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>

            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Button text="Eliminar Seleccionado" styleClass="menu-button" style="-fx-text-fill: red; -fx-font-weight: bold;" onAction="#eliminarAutor"/>
            </HBox>
        </VBox>

    </HBox>
</VBox>