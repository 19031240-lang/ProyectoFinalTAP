<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Button?>
<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="org.bibliotecafxv.controller.LoginController"
           stylesheets="@../css/style.css">

    <VBox alignment="CENTER"
          spacing="15"
          maxWidth="320"
          styleClass="card">

        <Label text="Biblioteca" styleClass="titulo"/>
        <Label text="Iniciar sesión" styleClass="subtitulo"/>

        <TextField fx:id="txtCorreo" promptText="Correo" styleClass="input"/>
        <PasswordField fx:id="txtPassword" promptText="Contraseña" styleClass="input"/>

        <Button text="Iniciar sesión"
                onAction="#login"
                maxWidth="Infinity"
                styleClass="btn-primary"/>

        <Button text="Crear cuenta"
                onAction="#irRegistro"
                maxWidth="Infinity"
                styleClass="btn-secondary"/>

        <Label fx:id="lblMensaje" styleClass="error"/>

    </VBox>

</StackPane>